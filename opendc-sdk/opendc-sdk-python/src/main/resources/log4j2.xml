<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%-5level %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Logs the progress of every run at WARN, which floods the output of a sweep -->
        <Logger name="org.opendc.sdk.runner.telemetry.ComputeMetricReader" level="error"/>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
